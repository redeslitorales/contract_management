<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_subscription_transfer_wizard_form" model="ir.ui.view">
        <field name="name">subscription.transfer.wizard.form</field>
        <field name="model">subscription.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Service Transfer Wizard">
                <sheet>
                    <group>
                        <field name="from_subscription_id" options="{'no_create': True}" context="{'contract_transfer_label': True}" string="Suscriptor Actual"/>
                        <field name="to_subscription_id" options="{'no_create': True}" context="{'contract_transfer_label': True}" string="Nuevo Suscriptor"/>
                        <field name="transfer_date"/>
                        <separator string="The destination subscription must have an active contract." colspan="2" class="text-warning"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Transfer" type="object" name="transfer_subscription" class="btn-primary"
                            confirm="Transfer service to the selected subscriber? This action cannot be undone."/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
