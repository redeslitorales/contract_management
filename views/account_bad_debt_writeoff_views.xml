<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_bad_debt_writeoff" model="ir.ui.view">
        <field name="name">account.move.form.bad.debt.writeoff</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//header/button[@name='action_register_payment'])[1]" position="after">
                <button name="action_open_bad_debt_writeoff"
                        type="object"
                        string="Write Off"
                        class="btn-secondary"
                        groups="account.group_account_user,base.group_system"
                        invisible="move_type != 'out_invoice' or state != 'posted' or amount_residual == 0"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_bad_debt_writeoff_entry"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        groups="account.group_account_user,base.group_system"
                        invisible="not bad_debt_writeoff_move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Write-Off Entry</span>
                    </div>
                </button>
                <field name="bad_debt_writeoff_move_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_bad_debt_writeoff_wizard_form" model="ir.ui.view">
        <field name="name">account.move.bad.debt.writeoff.wizard.form</field>
        <field name="model">account.move.bad.debt.writeoff.wizard</field>
        <field name="arch" type="xml">
            <form string="Write Off Invoice">
                <div class="alert alert-warning" role="alert">
                    This action writes off the complete current receivable balance. It does not create a credit note or alter the invoice's IVA or DTE.
                </div>
                <group>
                    <group>
                        <field name="move_id"/>
                        <field name="amount"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="expense_account_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <group>
                    <field name="reason" placeholder="Explain why this balance is considered uncollectible..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Write-Off" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
