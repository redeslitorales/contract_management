<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_account_statement_wizard_form" model="ir.ui.view">
        <field name="name">customer.account.statement.wizard.form</field>
        <field name="model">customer.account.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Account Statement">
                <group>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <div class="alert alert-info" role="alert">
                    The statement includes posted invoices, credit notes,
                    payments, and other receivable entries. Activity before
                    the start date is summarized as the opening balance.
                </div>
                <footer>
                    <button name="action_print" type="object"
                            string="Print Statement" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_account_statement_wizard" model="ir.actions.act_window">
        <field name="name">Customer Account Statement</field>
        <field name="res_model">customer.account.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="view_partner_form_customer_account_statement" model="ir.ui.view">
        <field name="name">res.partner.form.customer.account.statement</field>
        <field name="model">res.partner</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="customer_rank" invisible="1"/>
                <button name="action_open_account_statement_wizard"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        string="Account Statement"
                        groups="account.group_account_invoice,account.group_account_readonly"
                        invisible="customer_rank == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
