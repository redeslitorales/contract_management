<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract Dashboard Form View -->
    <record id="view_contract_dashboard_form" model="ir.ui.view">
        <field name="name">contract.dashboard.form</field>
        <field name="model">contract.dashboard</field>
        <field name="arch" type="xml">
            <form string="Contract Dashboard" class="o_contract_dashboard_form" create="false" delete="false" duplicate="false">
                <!-- Critical styles stay with the view so the dashboard remains usable
                     when Odoo's debug asset URL is cached across a module upgrade. -->
                <style>
                    .o_contract_dashboard_form{--cm-ink:#17223b;--cm-muted:#68748a;--cm-line:#e4e9f1;--cm-primary:#3157d5;background:#f4f7fb}
                    .o_contract_dashboard_form .cm-dashboard-sheet{max-width:none!important;margin:0!important;padding:0 32px 40px!important;border:0;background:transparent;box-shadow:none}
                    .o_contract_dashboard_form .cm-dashboard-hero{display:flex;align-items:center;justify-content:space-between;gap:32px;margin:0 -32px 24px;padding:34px 36px;color:#fff;background:radial-gradient(circle at 82% 20%,rgba(108,135,255,.42),transparent 28%),linear-gradient(125deg,#152445 0%,#243a70 58%,#3157d5 100%)}
                    .o_contract_dashboard_form .cm-dashboard-heading h1{margin:4px 0 7px;color:#fff;font-size:36px;font-weight:750}.o_contract_dashboard_form .cm-dashboard-heading p{margin:0;color:rgba(255,255,255,.72)}
                    .o_contract_dashboard_form .cm-eyebrow{color:#aabaff;font-size:11px;font-weight:800;letter-spacing:.14em}.o_contract_dashboard_form .cm-portfolio-value{min-width:240px;padding:17px 20px;border:1px solid rgba(255,255,255,.16);border-radius:16px;background:rgba(255,255,255,.1)}
                    .o_contract_dashboard_form .cm-portfolio-label,.o_contract_dashboard_form .cm-portfolio-meta{display:block;color:rgba(255,255,255,.7);font-size:12px}.o_contract_dashboard_form .cm-portfolio-number{margin:2px 0;font-size:28px;font-weight:750}
                    .o_contract_dashboard_form .cm-filter-panel,.o_contract_dashboard_form .cm-summary-card,.o_contract_dashboard_form .cm-dashboard-notebook{border:1px solid var(--cm-line);border-radius:14px;background:#fff;box-shadow:0 6px 22px rgba(23,34,59,.045)}
                    .o_contract_dashboard_form .cm-filter-panel{margin-bottom:18px;padding:18px 20px 20px}.o_contract_dashboard_form .cm-filter-heading{display:flex;gap:8px;margin-bottom:13px;color:var(--cm-ink);font-weight:750}
                    .o_contract_dashboard_form .cm-filter-grid{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:14px}.o_contract_dashboard_form .cm-filter-wide{grid-column:span 2}.o_contract_dashboard_form .cm-filter-field label{display:block;margin-bottom:5px;color:var(--cm-muted);font-size:11px;font-weight:750;text-transform:uppercase}
                    .o_contract_dashboard_form .cm-filter-field .o_field_widget{width:100%;min-height:32px;padding:3px 8px;border:1px solid #d9dfeb;border-radius:7px;background:#fafbfe}
                    .o_contract_dashboard_form .cm-kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:14px;margin-bottom:34px}.o_contract_dashboard_form button.cm-kpi-card{display:flex;align-items:center;min-height:96px;padding:16px;border:1px solid var(--cm-line);border-radius:14px;color:var(--cm-ink);text-align:left;background:#fff;box-shadow:0 6px 22px rgba(23,34,59,.045)}
                    .o_contract_dashboard_form .cm-kpi-icon,.o_contract_dashboard_form .cm-card-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;color:var(--cm-primary);background:#e9efff;font-size:18px}.o_contract_dashboard_form .cm-kpi-copy{display:flex;flex-direction:column;margin-left:12px}.o_contract_dashboard_form .cm-kpi-label{color:var(--cm-muted);font-size:12px;font-weight:650}.o_contract_dashboard_form .cm-kpi-number{font-size:25px;font-weight:800}.o_contract_dashboard_form .cm-kpi-arrow{margin-left:auto;color:#bcc5d4}
                    .o_contract_dashboard_form .cm-section-heading{margin:0 0 14px}.o_contract_dashboard_form .cm-section-heading h2{margin:3px 0 0;color:var(--cm-ink);font-size:22px;font-weight:750}.o_contract_dashboard_form .cm-details-heading{margin-top:34px}.o_contract_dashboard_form .cm-summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.o_contract_dashboard_form .cm-summary-card{min-width:0;padding:18px}.o_contract_dashboard_form .cm-card-heading{display:flex;align-items:center;gap:11px;margin-bottom:15px}.o_contract_dashboard_form .cm-card-heading h3,.o_contract_dashboard_form .cm-card-heading p{margin:0}
                    .o_contract_dashboard_form .cm-summary-table{max-height:410px;overflow:auto}.o_contract_dashboard_form .cm-dashboard-notebook{overflow:hidden}.o_contract_dashboard_form .cm-dashboard-notebook .tab-content{padding:20px}.o_contract_dashboard_form .cm-tab-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}.o_contract_dashboard_form .cm-tab-toolbar h3,.o_contract_dashboard_form .cm-tab-toolbar p{margin:0}
                    .o_contract_dashboard_form .cm-table-wrap{width:100%;overflow-x:auto}.o_contract_dashboard_form .cm-data-table{width:100%;min-width:700px}.o_contract_dashboard_form .cm-empty-state{padding:32px;border:1px dashed #d7deea;border-radius:10px;color:var(--cm-muted);text-align:center;background:#fafbfe}
                    @media(max-width:1100px){.o_contract_dashboard_form .cm-filter-grid{grid-template-columns:repeat(3,minmax(150px,1fr))}.o_contract_dashboard_form .cm-kpi-grid{grid-template-columns:repeat(3,minmax(180px,1fr))}.o_contract_dashboard_form .cm-summary-grid{grid-template-columns:1fr 1fr}.o_contract_dashboard_form .cm-summary-card:last-child{grid-column:span 2}}
                    @media(max-width:700px){.o_contract_dashboard_form .cm-dashboard-hero{align-items:stretch;flex-direction:column}.o_contract_dashboard_form .cm-filter-grid,.o_contract_dashboard_form .cm-kpi-grid,.o_contract_dashboard_form .cm-summary-grid{grid-template-columns:1fr}.o_contract_dashboard_form .cm-filter-wide,.o_contract_dashboard_form .cm-summary-card:last-child{grid-column:auto}}
                </style>
                <header>
                    <button name="action_refresh_statistics" type="object" string="Refresh dashboard" icon="fa-refresh" class="oe_highlight"/>
                </header>
                <sheet class="cm-dashboard-sheet">
                    <div class="cm-dashboard-hero">
                        <div class="cm-dashboard-heading">
                            <span class="cm-eyebrow">CONTRACT OPERATIONS</span>
                            <h1><field name="name" placeholder="Dashboard Name" nolabel="1"/></h1>
                            <p>Portfolio health, signature progress, renewals, and compliance at a glance.</p>
                        </div>
                        <div class="cm-portfolio-value">
                            <span class="cm-portfolio-label">Total paid value</span>
                            <div class="cm-portfolio-number"><field name="total_contract_value" nolabel="1"/></div>
                            <span class="cm-portfolio-meta">Average <field name="avg_contract_value" nolabel="1"/> per contract</span>
                        </div>
                    </div>

                    <div class="cm-filter-panel">
                        <div class="cm-filter-heading">
                            <i class="fa fa-sliders"/>
                            <span>Filter portfolio</span>
                        </div>
                        <div class="cm-filter-grid">
                            <div class="cm-filter-field">
                                <label for="date_from"/>
                                <field name="date_from" nolabel="1"/>
                            </div>
                            <div class="cm-filter-field">
                                <label for="date_to"/>
                                <field name="date_to" nolabel="1"/>
                            </div>
                            <div class="cm-filter-field cm-filter-wide">
                                <label for="partner_id"/>
                                <field name="partner_id" nolabel="1" options="{'no_create': True}"/>
                            </div>
                            <div class="cm-filter-field">
                                <label for="contract_term_id"/>
                                <field name="contract_term_id" nolabel="1" options="{'no_create': True}"/>
                            </div>
                            <div class="cm-filter-field">
                                <label for="state"/>
                                <field name="state" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="cm-kpi-grid">
                        <button name="action_view_all_contracts" type="object" class="cm-kpi-card cm-kpi-primary">
                            <span class="cm-kpi-icon"><i class="fa fa-file-text-o"/></span>
                            <span class="cm-kpi-copy">
                                <span class="cm-kpi-label">Total contracts</span>
                                <span class="cm-kpi-number"><field name="total_contracts" nolabel="1"/></span>
                            </span>
                            <i class="fa fa-arrow-right cm-kpi-arrow"/>
                        </button>
                        <button name="action_view_active_contracts" type="object" class="cm-kpi-card cm-kpi-success">
                            <span class="cm-kpi-icon"><i class="fa fa-check-circle"/></span>
                            <span class="cm-kpi-copy">
                                <span class="cm-kpi-label">Active</span>
                                <span class="cm-kpi-number"><field name="total_active" nolabel="1"/></span>
                            </span>
                            <i class="fa fa-arrow-right cm-kpi-arrow"/>
                        </button>
                        <button name="action_view_renewal_due_contracts" type="object" class="cm-kpi-card cm-kpi-info">
                            <span class="cm-kpi-icon"><i class="fa fa-repeat"/></span>
                            <span class="cm-kpi-copy">
                                <span class="cm-kpi-label">Renewal due</span>
                                <span class="cm-kpi-number"><field name="total_renewal_due" nolabel="1"/></span>
                            </span>
                            <i class="fa fa-arrow-right cm-kpi-arrow"/>
                        </button>
                        <button name="action_view_expiring_30_days" type="object" class="cm-kpi-card cm-kpi-warning">
                            <span class="cm-kpi-icon"><i class="fa fa-clock-o"/></span>
                            <span class="cm-kpi-copy">
                                <span class="cm-kpi-label">Expiring in 30 days</span>
                                <span class="cm-kpi-number"><field name="expiring_30_days" nolabel="1"/></span>
                            </span>
                            <i class="fa fa-arrow-right cm-kpi-arrow"/>
                        </button>
                        <button name="action_view_non_compliant" type="object" class="cm-kpi-card cm-kpi-danger">
                            <span class="cm-kpi-icon"><i class="fa fa-exclamation-triangle"/></span>
                            <span class="cm-kpi-copy">
                                <span class="cm-kpi-label">Needs attention</span>
                                <span class="cm-kpi-number"><field name="non_compliant_count" nolabel="1"/></span>
                            </span>
                            <i class="fa fa-arrow-right cm-kpi-arrow"/>
                        </button>
                    </div>

                    <div class="cm-section-heading">
                        <div>
                            <span class="cm-eyebrow">PORTFOLIO BREAKDOWN</span>
                            <h2>Where contracts stand</h2>
                        </div>
                    </div>

                    <div name="summary_row" class="cm-summary-grid">
                        <div class="cm-summary-card">
                            <div class="cm-card-heading">
                                <span class="cm-card-icon cm-icon-blue"><i class="fa fa-folder-open-o"/></span>
                                <div><h3>Contract status</h3><p>Lifecycle overview</p></div>
                            </div>
                            <field name="state_summary_html" widget="html" nolabel="1"/>
                        </div>
                        <div class="cm-summary-card">
                            <div class="cm-card-heading">
                                <span class="cm-card-icon cm-icon-purple"><i class="fa fa-pencil-square-o"/></span>
                                <div><h3>Signature status</h3><p>Envelope progress</p></div>
                            </div>
                            <field name="signature_summary_html" widget="html" nolabel="1"/>
                        </div>
                        <div class="cm-summary-card">
                            <div class="cm-card-heading">
                                <span class="cm-card-icon cm-icon-green"><i class="fa fa-tasks"/></span>
                                <div><h3>Progress stage</h3><p>Operational pipeline</p></div>
                            </div>
                            <field name="progress_stage_summary_html" widget="html" nolabel="1"/>
                        </div>
                    </div>

                    <div class="cm-section-heading cm-details-heading">
                        <div>
                            <span class="cm-eyebrow">DETAILS</span>
                            <h2>Focus lists</h2>
                        </div>
                    </div>

                    <notebook class="cm-dashboard-notebook">
                        <page string="Expiring · 30 days" name="expiration_30">
                            <div class="cm-tab-toolbar">
                                <div><h3>Immediate renewals</h3><p>Active contracts ending in the next 30 days.</p></div>
                                <button name="action_view_expiring_30_days" type="object" class="btn btn-outline-primary" icon="fa-external-link" string="Open all"/>
                            </div>
                            <field name="expiring_30_days_list" widget="html" nolabel="1" placeholder="No contracts expiring in 30 days"/>
                        </page>

                        <page string="Expiring · 60 days" name="expiration_60">
                            <div class="cm-tab-toolbar">
                                <div><h3>Upcoming renewals</h3><p>Active contracts ending in the next 60 days.</p></div>
                                <button name="action_view_expiring_60_days" type="object" class="btn btn-outline-primary" icon="fa-external-link" string="Open all"/>
                            </div>
                            <field name="expiring_60_days_list" widget="html" nolabel="1" placeholder="No contracts expiring in 60 days"/>
                        </page>

                        <page string="Expiring · 90 days" name="expiration_90">
                            <div class="cm-tab-toolbar">
                                <div><h3>Renewal pipeline</h3><p>Active contracts ending in the next 90 days.</p></div>
                                <button name="action_view_expiring_90_days" type="object" class="btn btn-outline-primary" icon="fa-external-link" string="Open all"/>
                            </div>
                            <field name="expiring_90_days_list" widget="html" nolabel="1" placeholder="No contracts expiring in 90 days"/>
                        </page>

                        <page string="Needs attention" name="non_compliant">
                            <div class="cm-tab-toolbar">
                                <div><h3>Contract exceptions</h3><p>Contracts whose state conflicts with their subscription.</p></div>
                                <button name="action_view_non_compliant" type="object" class="btn btn-outline-danger" icon="fa-external-link" string="Open all"/>
                            </div>
                            <field name="non_compliant_list" widget="html" nolabel="1" placeholder="No non compliant contracts"/>
                        </page>

                        <page string="Top customers" name="partners">
                            <div class="cm-tab-toolbar">
                                <div><h3>Largest customer portfolios</h3><p>Top ten customers by contract count.</p></div>
                            </div>
                            <field name="top_partners_summary" widget="html" nolabel="1"/>
                        </page>

                        <page string="Contract terms" name="terms">
                            <div class="cm-tab-toolbar">
                                <div><h3>Term distribution</h3><p>How the portfolio is distributed by contract term.</p></div>
                            </div>
                            <field name="term_distribution" widget="html" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Contract Dashboard Kanban View -->
    <record id="view_contract_dashboard_kanban" model="ir.ui.view">
        <field name="name">contract.dashboard.kanban</field>
        <field name="model">contract.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="false">
                <field name="name"/>
                <field name="total_contracts"/>
                <field name="total_active"/>
                <field name="total_draft"/>
                <field name="total_expired"/>
                <field name="total_renewal_due"/>
                <field name="total_contract_value"/>
                <field name="avg_contract_value"/>
                <field name="expiring_30_days"/>
                <field name="expiring_60_days"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary"><field name="name"/></div>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row">
                                    <div class="col-3">
                                        <button class="btn btn-primary" name="action_view_active_contracts" type="object">
                                            <span><t t-esc="record.total_active.value"/> Active</span>
                                        </button>
                                    </div>
                                    <div class="col-3">
                                        <button class="btn btn-info" name="action_view_renewal_due_contracts" type="object">
                                            <span><t t-esc="record.total_renewal_due.value"/> Renewal Due</span>
                                        </button>
                                    </div>
                                    <div class="col-3">
                                        <button class="btn btn-warning" name="action_view_expired_contracts" type="object">
                                            <span><t t-esc="record.total_expired.value"/> Expired</span>
                                        </button>
                                    </div>
                                    <div class="col-3">
                                        <button class="btn btn-secondary" name="action_view_draft_contracts" type="object">
                                            <span><t t-esc="record.total_draft.value"/> Draft</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-6">
                                        <strong>Total Contracts</strong><br/>
                                        <span class="o_stat_value"><t t-esc="record.total_contracts.value"/></span>
                                    </div>
                                    <div class="col-6">
                                        <strong>Total Value</strong><br/>
                                        <span class="o_stat_value">$<t t-esc="Math.round(record.total_contract_value.value * 100) / 100"/></span>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <button class="btn btn-sm btn-outline-warning" name="action_view_expiring_30_days" type="object">
                                            <i class="fa fa-exclamation-triangle"/> <t t-esc="record.expiring_30_days.value"/> Expiring in 30 Days
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Contract Dashboard Action -->
    <record id="action_contract_dashboard" model="ir.actions.act_window">
        <field name="name">Contract Dashboard</field>
        <field name="res_model">contract.dashboard</field>
        <field name="view_mode">form,kanban</field>
        <field name="res_id" eval="ref('contract_management.contract_dashboard_default')"/>
        <field name="domain">[]</field>
        <field name="context">{'default_name': 'Contract Overview'}</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Contract Management Dashboard
            </p>
            <p>
                View contract statistics by status, partner, term, and expiration date.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_contract_dashboard"
              name="Dashboard"
              parent="menu_contract_management_root"
              action="action_contract_dashboard"
              sequence="1"/>
</odoo>
